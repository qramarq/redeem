# Optional. fetch-isos.sh downloads this only with --with-winpe.
# Hiren's BootCD PE x64 v1.0.8. On 2026-11-06 the URL returned HTTP 302 to
# https://mirrors.rit.edu/hbcd/HBCD_PE_x64.iso and then HTTP 200, Content-Length
# 3291686912, without a special Referer. SHA-256 is the project pin for that ISO.
HBCD_VERSION=1.0.8
HBCD_FILE=HBCD_PE_x64.iso
HBCD_URL=https://www.hirensbootcd.org/files/HBCD_PE_x64.iso
HBCD_SHA256=8c4c670c9c84d6c4b5a9c32e0aa5a55d8c23de851d259207d54679ea774c2498
HBCD_REFERER=https://www.hirensbootcd.org/

LLAMA_CPP_VERSION=v0.9.0
LLAMA_CPP_URL=https://github.com/ggml-org/llama.cpp.git

# Optional host CPU binaries. The v0.9.0 git tag has no Windows/macOS assets.
# Its release notes name nightly build b12110 as the binary build of 0.9.0.
# SHA-256 values are the GitHub release asset digests, confirmed by downloading
# the three archives on 2026-11-05.
LLAMA_HOST_TAG=b12110
LLAMA_HOST_WIN_X64_FILE=llama-b12110-bin-win-cpu-x64.zip
LLAMA_HOST_WIN_X64_URL=https://github.com/ggml-org/llama.cpp/releases/download/b12110/llama-b12110-bin-win-cpu-x64.zip
